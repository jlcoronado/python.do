// ============================================================================
// ProjectManifest.json5 — python.do (Wagtail CMS)
// ============================================================================
{
  "meta": {
    "version": "1.0.0",
    "lastUpdated": "2026-05-17T16:00:00Z",
    "type": "public-manifest",
    "companionFile": "ProjectMemory.json5 (gitignored — local paths, session logs)",
    "instructions": "Update decisionsLog on architectural decisions. Keep local paths and credentials out of this file."
  },

  "project": {
    "name": "python.do",
    "displayName": "python.do",
    "owner": "Your Organization",
    "architect": "Lead Architect",
    "description": "Community site for Python users in the Dominican Republic: events, resources, and Wagtail-managed content with Tailwind, DaisyUI (dark default), HTMX, Alpine.js, and GSAP.",
    "status": "Active — Wagtail 7.4 LTS on initialization branch",
    "currentVersion": "0.2.0",
    "nextVersion": "0.3.0",
    "repositoryUrl": "https://github.com/jlcoronado/python.do"
  },

  "stack": {
    "summary": "Python 3.12+, Wagtail 7.4 LTS, Django 5.2, Tailwind CSS, DaisyUI (dark), HTMX, Alpine.js, GSAP",
    "languages": ["Python", "HTML", "CSS", "JavaScript"],
    "frameworks": ["Django", "Wagtail", "Tailwind CSS", "DaisyUI", "HTMX", "Alpine.js", "GSAP"],
    "databases": ["PostgreSQL"],
    "tooling": ["pytest", "ruff", "npm"]
  },

  "architecture": {
    "style": "Wagtail pages/models + Django templates; static pipeline for Tailwind",
    "dependencyGraph": "Wagtail models → views/snippets → templates; HTMX partials; JS only in theme/static",
    "layers": {
      "common": "core",
      "domain": "apps",
      "application": "apps",
      "infrastructure": "config",
      "ui": "theme",
      "host": "."
    }
  },

  "domainBoundaries": {
    "treeFocus": ["apps", "config", "theme", "templates", "."],
    "excludeDirs": [
      "node_modules",
      "bin",
      "obj",
      ".git",
      "dist",
      "build",
      ".cursor-agent-backups",
      "venv",
      ".venv"
    ],
    "includeExtensions": [".py", ".html", ".css", ".js", ".json", ".yaml", ".md"]
  },

  "agentActivation": {
    "templateKit": "scripts/install.sh, scripts/restore-backup.sh, profiles/**, template/**, docs/ADOPTION.md, docs/INSTALL-OPTIONS.md",
    "backend": "**/*.py",
    "frontend": "**/*.{html,css,js},templates/**,theme/**,static/**",
    "dba": "**/migrations/**, **/models.py",
    "security": "**/settings*.py, **/.env*, **/wagtail/**",
    "infra": "**/Dockerfile*, **/docker-compose*, **/*.yml, **/*.yaml",
    "perf": "**/cache*.py",
    "tests": "**/test_*.py, **/tests/**"
  },

  "architectureGuards": [
    "Page models and StreamField blocks only in Wagtail apps",
    "Templates must not run ORM queries or business logic",
    "HTMX endpoints return partials; no full SPA for catalog search and filters",
    "Default UI theme is DaisyUI dark (data-theme)",
    "No secrets in source control — use environment variables or local credentials file"
  ],

  "decisionsLog": [
    {
      "date": "2026-05-17",
      "decision": "Upgrade Wagtail 6.4 to 7.4 LTS with Django 5.2",
      "reason": "Admin upgrade notice; 7.4 is current LTS with security support",
      "alternativesDiscarded": ["Stay on 6.4 — rejected; missing LTS fixes and Django 5.2 alignment"]
    },
    {
      "date": "2026-05-17",
      "decision": "Stack: Wagtail CMS with Tailwind, DaisyUI dark, HTMX, Alpine.js, GSAP",
      "reason": "CMS for community content and pages; server-rendered templates with progressive enhancement",
      "alternativesDiscarded": ["FastAPI-only API — rejected; content site needs Wagtail pages"]
    }
  ],
  "pendingDecisions": [],
  "openQuestions": [
    "PostgreSQL hosting and environment layout for production"
  ],
  "observations": [],

  "branchStatus": {
    "branch": "initialization",
    "goal": "Wagtail scaffold complete; ready for content models and merge to dev",
    "completedSteps": [
      "AOK agents installed via python-wagtail profile",
      "Git repository initialized with main, dev, and initialization branches",
      "Wagtail + Tailwind/DaisyUI + HTMX search + Alpine nav + GSAP hero",
      "Upgraded to Wagtail 7.4 LTS and Django 5.2"
    ],
    "pendingIssues": ["Production hosting", "CI pipeline", "Community page types (events, resources)"]
  },

  "verifyCommands": {
    "build": "python manage.py check; npm run build",
    "test": "pytest -q",
    "lint": "ruff check ."
  }
}
