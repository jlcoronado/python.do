# Copy to .env and adjust for local development.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

POSTGRES_DB=python_do
POSTGRES_USER=python_do
POSTGRES_PASSWORD=python_do
POSTGRES_HOST=localhost
# Use 5433 so Docker does not clash with another Postgres on 5432
POSTGRES_PORT=5433

# Set to 1 to skip Docker and use db.sqlite3 in the project root
# USE_SQLITE=0

WAGTAILADMIN_BASE_URL=http://localhost:8000
